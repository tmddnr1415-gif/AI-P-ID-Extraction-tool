__pycache__/
*.pyc

# Source drawings are large binaries supplied per project, not repo content.
data/*.pdf
data/*.xlsx

# Viewer page backdrops are regenerated from the PDF by
# `spike/detect_valves.py --viewer out/viewer`; only the overlay data and the
# viewer itself are repo content.
out/viewer/*.png

# Runtime state: uploads, SQLite, generated workbooks.
app/_data/

# Packaging output and the date stamp `build.bat` writes into the build.  The
# stamp is generated, never committed: a checked-in build date would claim a
# release that never happened.
build/
dist/
app/_build.json
