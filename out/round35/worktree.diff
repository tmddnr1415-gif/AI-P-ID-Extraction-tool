"""35회차 — 지운 상수의 자리 (worktree 전용).

값이 "없다" 를 0 이나 빈 문자열과 **구분**하기 위한 sentinel.  산술·비교·bool·
str·iter·len·getattr 어느 것이든 닿는 순간 `MissingConstant(이름)` 을 던진다 —
None 이 조용히 흘러 이상한 값을 내는 (c) 갈래를 막는다.  `==`·`hash`·`repr`·
deepcopy 만 조용하다 (`analyse` 의 config 스냅샷 대조와 json 덤프의 `default=str`
전에 repr 이 필요해서).

복원 목록(`R35_RESTORED`, 쉼표로 이은 이름)에 든 이름은 원래 값을 돌려준다 —
[D] 의 "하나씩 되살린다" 가 소스 재수정 없이 환경변수 하나로 된다.
"""
from __future__ import annotations

import os


class MissingConstant(RuntimeError):
    pass


class Missing:
    __slots__ = ("name",)

    def __init__(self, name: str):
        object.__setattr__(self, "name", name)

    def _raise(self, *a, **k):
        raise MissingConstant(self.name)

    # 조용한 것 — 스냅샷 대조 · 사전 키 · 덤프 · 복사
    def __repr__(self):
        return f"<MISSING {self.name}>"

    def __eq__(self, other):
        return other is self

    def __hash__(self):
        return hash(("MISSING", self.name))

    def __deepcopy__(self, memo):
        return self

    def __copy__(self):
        return self

    def __reduce__(self):
        return (Missing, (self.name,))

    # 시끄러운 것 — 값으로 쓰려는 모든 길
    __bool__ = __str__ = __iter__ = __len__ = __getitem__ = __contains__ = _raise
    __lt__ = __le__ = __gt__ = __ge__ = _raise
    __add__ = __radd__ = __sub__ = __rsub__ = __mul__ = __rmul__ = _raise
    __truediv__ = __rtruediv__ = __floordiv__ = __rfloordiv__ = _raise
    __neg__ = __abs__ = __float__ = __int__ = __index__ = __round__ = _raise
    __call__ = __fspath__ = _raise

    def __getattr__(self, item):
        raise MissingConstant(f"{self.name} (.{item})")


def restored() -> set:
    return {s.strip() for s in os.environ.get("R35_RESTORED", "").split(",") if s.strip()}


def M(name: str, original):
    """dataclass 기본값 자리.  복원 목록에 있으면 원래 값, 아니면 sentinel."""
    if os.environ.get("R35_NO_STRIP"):
        return original
    return original if name in restored() else Missing(name)


# --- 변환기 통과 -----------------------------------------------------------
# 조립 함수는 import 때 `float(cfg.get_or(...))` 을 한다.  거기서 sentinel 이
# 터지면 `_fit_layout` 이 유도값을 얹을 기회조차 없다 — 그것은 발견이 아니라
# 절차의 부산물이다.  변환기만 sentinel 을 **그대로 통과**시키고, 값으로 쓰는
# 순간(검출 산술·정규식 매칭)에 터지게 둔다.
def _is(x):  return type(x).__name__ == "Missing"   # 모듈 정체가 둘(app.engine.missing / missing)이라 이름으로 본다
def pf(x):  return x if _is(x) else float(x)
def pi(x):  return x if _is(x) else int(x)
def pt(x):  return x if _is(x) else tuple(x)
def pre(x):
    import re
    return x if _is(x) else re.compile(x)


def strip_config(data: dict, keys, restored_names: set) -> list:
    """config 잎을 sentinel 로 바꾼다 (지우지 않는다 — `.get(...) or 기본값` 이
    조용히 삼키지 못하게).  복원 목록의 키는 건드리지 않는다.  바꾼 키를 돌려준다."""
    done = []
    for dotted in keys:
        name = "cfg." + dotted
        if name in restored_names:
            continue
        parts = dotted.split("."); node = data
        for p in parts[:-1]:
            if not isinstance(node, dict) or p not in node:
                node = None; break
            node = node[p]
        if isinstance(node, dict) and parts[-1] in node:
            node[parts[-1]] = Missing(name); done.append(name)
    return done
