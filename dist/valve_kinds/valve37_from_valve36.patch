+    miss = {i["key"] for i in psv["issues"] if i["type"] == "Data Missing"}
+    assert "op_pressure" in miss                                                          # blank PROCESS DATA item, once
+    assert len([i for i in psv["issues"] if i["ikey"] == "Data Missing:op_pressure"]) == 1
