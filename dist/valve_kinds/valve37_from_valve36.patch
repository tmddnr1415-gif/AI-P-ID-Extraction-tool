+    assert F["paint_body"] == "RAL 7035" and F["paint_handwheel"] == "RAL 1003" and F["handwheel"] == "Yes"
+    assert F["tubing"] == "SS316" and F["tubing_size"] == '1/2"' and F["afr_manufacturer"] == "Bellofram" and F["vt_tag"] == "N/A"
